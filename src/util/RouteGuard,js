import React, { useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import toast from 'react-hot-toast';

export default function RouteGuard({ children }) {
  
  // const navigate = useNavigate();

  useEffect(() => {
    const checkAuth = () => {
      const userDetailStr = localStorage.getItem('userDetail');
      const token = localStorage.getItem('token');

      if (!token || !userDetailStr) {
        // navigate('/login');
        return;
      }

      try {
        const decodedToken = JSON.parse(atob(token.split('.')[1]));
        const role = decodedToken.role;
        const currentPath = window.location.pathname;
        
        if (role === 'investor') {
          // Investors can only access investor-landing and price-oracle
          if (!currentPath.includes('/investor-landing') && !currentPath.includes('/price-oracle')) {
            // navigate('/investor-landing');
          }
        } else if (currentPath.includes('/investor-landing')) {
          // Non-investors shouldn't access investor landing
          // navigate('/dashboard');
        }
      } catch (error) {
        console.error('Error processing token:', error);
        localStorage.removeItem('token');
        localStorage.removeItem('userDetail');
        // navigate('/login');
        toast.error('Session expired. Please login again.');
      }
    };

    checkAuth();
  }, [/*navigate*/]);

  return children;
}